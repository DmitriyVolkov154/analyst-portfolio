        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    subgraph СТАРТ[\&quot;🌟 СТАРТ: Я здесь\&quot;]\n        Start[\&quot;Я — системный аналитик в промышленности&lt;br&gt;(MES, SAP, АСУ ТП, ISA-95)\&quot;]\n        StartGoal[\&quot;Цель: перейти в Ozon Tech / финтех&lt;br&gt;Зарплата: 200 000 ₽\&quot;]\n        Start --&gt; StartGoal\n    end\n\n    subgraph МЕСЯЦ1[\&quot;🧱 МЕСЯЦ 1: Закладываю фундамент\&quot;]\n        M1_1[\&quot;📬 Postman: отправляю первый GET-запрос&lt;br&gt;(если не идёт — Bruno/Hoppscotch)\&quot;]\n        M1_2[\&quot;🧠 SQL: оконные функции, CTE, ROW_NUMBER()&lt;br&gt;решаю 5 задач на LeetCode\&quot;]\n        M1_3[\&quot;📝 User Story: переписываю 3 рабочие задачи&lt;br&gt;в формат «As a… I want… So that…»\&quot;]\n        M1_4[\&quot;✏️ Диаграммы: рисую 5 схем в Mermaid&lt;br&gt;и кладу их в портфолио\&quot;]\n        \n        M1_1 --&gt; M1_2 --&gt; M1_3 --&gt; M1_4\n    end\n\n    subgraph МЕСЯЦ2[\&quot;⚙️ МЕСЯЦ 2: Учу технологии\&quot;]\n        M2_1[\&quot;📨 Kafka: разбираюсь с Topic, Partition,&lt;br&gt;Producer, Consumer — пишу шпаргалку\&quot;]\n        M2_2[\&quot;🏗️ Микросервисы: читаю Ньюмена,&lt;br&gt;рисую схему «Как устроен заказ в Ozon»\&quot;]\n        M2_3[\&quot;📄 OpenAPI: делаю свою первую&lt;br&gt;спецификацию в Swagger Editor\&quot;]\n        \n        M2_1 --&gt; M2_2 --&gt; M2_3\n    end\n\n    subgraph МЕСЯЦ3[\&quot;💸 МЕСЯЦ 3: Погружаюсь в финтех\&quot;]\n        M3_1[\&quot;💳 Платежи: эквайринг, процессинг,&lt;br&gt;банк-эмитент — смотрю видео + читаю\&quot;]\n        M3_2[\&quot;🔁 Транзакции: ACID, Saga, компенсации&lt;br&gt;— записываю 3 примера из жизни\&quot;]\n        M3_3[\&quot;🧪 Пет-проект: описываю платёжный шлюз&lt;br&gt;— схема + 3 API-метода\&quot;]\n        M3_4[\&quot;📦 Собираю портфолио: GitHub&lt;br&gt;— диаграммы, SQL, OpenAPI, User Story\&quot;]\n        \n        M3_1 --&gt; M3_2 --&gt; M3_3 --&gt; M3_4\n    end\n\n    subgraph МЕСЯЦ4[\&quot;🚀 МЕСЯЦ 4: Выхожу на рынок\&quot;]\n        M4_1[\&quot;📄 Обновляю резюме: добавляю навыки,&lt;br&gt;указываю портфолио, повышаю ЗП до 200\&quot;]\n        M4_2[\&quot;✉️ Пишу сопроводительное письмо&lt;br&gt;под Ozon Tech, Т-Банк, Альфа-Банк\&quot;]\n        M4_3[\&quot;🎤 Готовлюсь к собеседованиям:&lt;br&gt;проговариваю ответы на 20 вопросов\&quot;]\n        M4_4[\&quot;🏆 Получаю оффер на 170–200 тыс.\&quot;]\n        \n        M4_1 --&gt; M4_2 --&gt; M4_3 --&gt; M4_4\n    end\n\n    subgraph НАВЫКИ[\&quot;🧰 Что я получу в конце пути\&quot;]\n        Skill1[\&quot;✅ Postman / API-тестирование\&quot;]\n        Skill2[\&quot;✅ SQL (оконные функции, CTE)\&quot;]\n        Skill3[\&quot;✅ UML, BPMN, Mermaid\&quot;]\n        Skill4[\&quot;✅ Kafka, микросервисы\&quot;]\n        Skill5[\&quot;✅ OpenAPI / Swagger\&quot;]\n        Skill6[\&quot;✅ Платежи, транзакции, Saga\&quot;]\n        Skill7[\&quot;✅ Портфолио на GitHub\&quot;]\n        Skill8[\&quot;✅ Резюме под финтех / e-commerce\&quot;]\n    end\n\n    %% Связи между этапами\n    StartGoal --&gt; M1_1\n    M1_4 --&gt; M2_1\n    M2_3 --&gt; M3_1\n    M3_4 --&gt; M4_1\n    M4_4 --&gt; НАВЫКИ\n\n    %% Альтернативные сценарии (план Б)\n    M1_1 -.-&gt;|\&quot;❌ Если Postman не идёт\&quot;| Alt1[\&quot;🔄 Bruno / Hoppscotch\&quot;]\n    M2_2 -.-&gt;|\&quot;📖 Если книга сложная\&quot;| Alt2[\&quot;🎥 Смотрю YouTube-лекцию\&quot;]\n    M4_2 -.-&gt;|\&quot;📭 Если нет откликов\&quot;| Alt3[\&quot;➕ Расширяю список: СберТех, Яндекс, ЮKassa\&quot;]\n\n    %% Стили — яркие, для настроения\n    style СТАРТ fill:#dbeafe,stroke:#1e40af,stroke-width:2px,color:#1e3a8a\n    style МЕСЯЦ1 fill:#d1fae5,stroke:#065f46,stroke-width:2px,color:#064e3b\n    style МЕСЯЦ2 fill:#fef3c7,stroke:#92400e,stroke-width:2px,color:#78350f\n    style МЕСЯЦ3 fill:#fce7f3,stroke:#9d174d,stroke-width:2px,color:#831843\n    style МЕСЯЦ4 fill:#e0e7ff,stroke:#3730a3,stroke-width:2px,color:#1e1b4b\n    style НАВЫКИ fill:#f3e8ff,stroke:#6b21a8,stroke-width:2px,color:#4c1d95\n\n    %% Стили для альтернатив\n    style Alt1 fill:#fee2e2,stroke:#991b1b,stroke-width:1px,color:#7f1d1d\n    style Alt2 fill:#fee2e2,stroke:#991b1b,stroke-width:1px,color:#7f1d1d\n    style Alt3 fill:#fee2e2,stroke:#991b1b,stroke-width:1px,color:#7f1d1d&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="s_4aJh9-gFUZgbtnYuq_-1">
