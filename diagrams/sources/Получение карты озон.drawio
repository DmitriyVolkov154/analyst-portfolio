        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    subgraph Этап1[\&quot;📱 1. Оформление заявки\&quot;]\n        A1[Перейти в профиль Ozon]\n        A2[Выбрать «Открыть Ozon Карту»]\n        A3[Заполнить анкету]\n        A4[Ввести паспортные данные]\n        A5[Придумать кодовое слово]\n        A1 --&gt; A2 --&gt; A3 --&gt; A4 --&gt; A5\n    end\n\n    subgraph Этап2[\&quot;✅ 2. Подтверждение\&quot;]\n        B1[Подтверждение по SMS]\n        B2[Придумать пароль для Ozon Банка]\n        B3[Виртуальная карта открыта]\n        B1 --&gt; B2 --&gt; B3\n    end\n\n    subgraph Этап3[\&quot;💳 3. Получение карты\&quot;]\n        C1[Заказать пластик в корзине]\n        C2[Выбрать доставку: курьер или ПВЗ]\n        C3[Проверка паспорта сотрудником]\n        C4[Подписание анкеты]\n        C5[Получение карты]\n        C1 --&gt; C2 --&gt; C3 --&gt; C4 --&gt; C5\n    end\n\n    subgraph Этап4[\&quot;🔓 4. Активация\&quot;]\n        D1[СМС с кодовым словом]\n        D2[Получение PIN-кода]\n        D3[Активация карты]\n        D1 --&gt; D2 --&gt; D3\n    end\n\n    subgraph Этап5[\&quot;💰 5. Использование\&quot;]\n        E1[Пополнение через СБП]\n        E2[Пополнение с карт других банков]\n        E3[Оплата покупок на Ozon]\n        E4[Оплата в магазинах]\n        E5[Кэшбэк до 25%]\n        E1 --&gt; E2 --&gt; E3 --&gt; E4 --&gt; E5\n    end\n\n    %% Связи между этапами\n    A5 --&gt; B1\n    B3 --&gt; C1\n    C5 --&gt; D1\n    D3 --&gt; E1\n\n    %% Альтернативные сценарии\n    C2 -.-&gt;|Курьер| C3\n    C2 -.-&gt;|ПВЗ| C3\n    E1 -.-&gt;|СБП по номеру| E2\n    E1 -.-&gt;|С карты| E2\n\n    %% Стили\n    style Этап1 fill:#e1f5ff,stroke:#333,stroke-width:2px\n    style Этап2 fill:#e1ffe1,stroke:#333,stroke-width:2px\n    style Этап3 fill:#fff4e1,stroke:#333,stroke-width:2px\n    style Этап4 fill:#ffe1f5,stroke:#333,stroke-width:2px\n    style Этап5 fill:#f0e1ff,stroke:#333,stroke-width:2px&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="r4d8